# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public domain of the API and the website (DNS A/AAAA record to the VPS).
API_DOMAIN=api.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Long random values: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=

# OAuth client IDs whose Google ID tokens are accepted (Android + web).
GOOGLE_CLIENT_IDS=
# Start of links in emails. With a domain and app links, use https://API_DOMAIN/
LINK_BASE=pennywise://

# The API refuses MAILER=log in production: verification and password
# reset emails need a real provider first (not chosen yet, see PLAN.md).
MAILER=

# Private R2 bucket for receipts and exports (Cloudflare dashboard >
# R2 > API token with Object Read & Write on this bucket only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Backups (deploy/backup.sh): a SECOND private bucket, its own token.
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
