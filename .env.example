# Copy to .env and adjust. Never commit .env.
APP_ENV=development
HTTP_ADDR=:8080

POSTGRES_USER=pennywise
POSTGRES_PASSWORD=pennywise_dev_password
POSTGRES_DB=pennywise
DATABASE_URL=postgres://pennywise:pennywise_dev_password@localhost:5432/pennywise?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# Signs access tokens. At least 32 bytes. Generate your own:
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated Google OAuth client IDs (Android, iOS, web) whose ID tokens
# are accepted. Leave empty to switch Google sign-in off.
GOOGLE_CLIENT_IDS=

# Start of links in emails (app deep link).
LINK_BASE=pennywise://

# "log" prints emails to the log instead of sending them. Development only.
MAILER=log

# Daily exchange rates (Frankfurter, free, no key). Change only to self-host it.
FX_API_URL=https://api.frankfurter.dev/v1

# Integration tests (they wipe these databases):
TEST_DATABASE_URL=postgres://pennywise:pennywise_dev_password@localhost:5432/pennywise_test?sslmode=disable
TEST_REDIS_URL=redis://localhost:6379/15
